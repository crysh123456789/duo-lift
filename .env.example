# Retirada. La app ya no lee esta variable. Supabase Auth es la sesión.
# Después del corte, bórrala en Vercel (Production y Preview) y vuelve a desplegar.
# Opcional, una sola vez antes del corte: cámbiala por un valor aleatorio para
# invalidar las cookies duo_session viejas. Este release no las usa.
DUO_LIFT_PASSWORD=

# Supabase — proyecto Duo Lift (sa-east-1). La URL no es secreta.
# En Vercel, define estas variables en Production y Preview. No commitees llaves.
NEXT_PUBLIC_SUPABASE_URL=https://xivctpewomnpzcgbvczv.supabase.co
# Legacy anon JWT (Dashboard → Project Settings → API → anon public).
# Si esta queda vacía, también se acepta NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor. Ya no es el camino de /api/sync. Nunca uses el prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# true sube la bitácora de la cuenta que inició sesión. Un fallo deja los datos en el teléfono.
DUO_LIFT_SYNC_ENABLED=false
