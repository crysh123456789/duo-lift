# Clave compartida del dúo. Obligatoria en producción.
# En local, si está vacía, el valor de desarrollo es: duolift
# (fuera de development, vacía deja la app abierta a propósito).
# La sesión firmada caduca a los 30 días. La cookie es Secure solo en producción.
DUO_LIFT_PASSWORD=

# Supabase — proyecto Duo Lift (sa-east-1). La URL no es secreta.
# En Vercel, define estas variables en Production y Preview. No commitees llaves.
NEXT_PUBLIC_SUPABASE_URL=https://xivctpewomnpzcgbvczv.supabase.co
# Legacy anon JWT (Dashboard → Project Settings → API → anon public).
# Si esta queda vacía, también se acepta NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor. La service role salta RLS. Nunca uses el prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Déjalo en false hasta que Seguridad revise supabase/migrations/0002_duo_local_sync.sql.
# true activa el dual-write: hidrata desde Supabase y sube el localStorage existente.
DUO_LIFT_SYNC_ENABLED=false
